{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeg-mobile",
  "version": "0.1.0",
  "identifier": "com.jiaweiwu.codegmobile",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codeg",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "remote-token-access",
          "description": "Allows remote service pages to fetch the active token and report JS errors back to Rust.",
          "remote": {
            "urls": ["http://*", "https://*"]
          },
          "windows": ["main"],
          "permissions": [
            "allow-get-active-token",
            "allow-log-js-error"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}

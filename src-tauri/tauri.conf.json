{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeg-mobile",
  "version": "0.1.0",
  "identifier": "com.jiaweiwu.codegmobile",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codeg",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
